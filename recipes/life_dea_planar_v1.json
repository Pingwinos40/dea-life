{
  "schema": "sldea-lifecycle/1",
  "name": "LIFE-DEA planar v1",
  "description": "Flagship lifecycle protocol (stratosphere-paper lineage): drive at 50% of the specimen's median breakdown field for the test temperature, fast interlude every 1e3 cycles, full staircase interlude every 5e4, run to failure / no-strain / 1e6-cycle cap. A specimen reaching the cap is a SUSPENSION (right-censored). Claim gate format: 'N cycles without dielectric breakdown'.",
  "geometry": "planar",
  "drive": {"waveform": "SINE", "freq_hz": 5.0,
            "v_pk": {"fraction_of_breakdown": 0.5, "temp_c": 23},
            "v_min_kv": 0.0},
  "reference": {"ref_kv": 1.0, "ref_freq_hz": 0.1, "ref_cycles": 3,
                "leak_hold_kv": 1.0, "leak_hold_s": 20.0},
  "environment": {"t_c_band": [18, 28], "p_mbar_band": [900, 1100],
                  "stale_after_s": 1800, "reattest_on_rearm": true},
  "counting": "burst",
  "camera_track_max_hz": 0.5,
  "stop": {"max_cycles": 1000000, "max_wall_h": 168},
  "failure_rules": {},
  "blocks": [
    {"type": "wait_env",
     "prompt": "Enter chamber T (C) and pressure (mbar) before break-in."},
    {"type": "cycle", "role": "break_in", "n_cycles": 500},
    {"type": "full_interlude", "set_baseline": true,
     "staircase": {"start_kv": 0.0, "end_kv": {"fraction_of_vpk": 0.8},
                   "step_kv": 0.2, "ramp_s": 2.0, "landing_s": 8.0,
                   "settle_s": 2.0, "snap_lead_s": 1.0}},
    {"type": "loop", "repeat": 20, "blocks": [
      {"type": "loop", "repeat": 50, "blocks": [
        {"type": "cycle", "n_cycles": 1000},
        {"type": "fast_interlude"}
      ]},
      {"type": "full_interlude",
       "staircase": {"start_kv": 0.0, "end_kv": {"fraction_of_vpk": 0.8},
                     "step_kv": 0.2, "ramp_s": 2.0, "landing_s": 8.0,
                     "settle_s": 2.0, "snap_lead_s": 1.0}}
    ]}
  ]
}
